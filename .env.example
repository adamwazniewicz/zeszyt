# Server
IDU_BASE_URL=https://s31.idu.edu.pl
IDU_USER_AGENT="Zeszyt/0.1 (unofficial student client; +mailto:you@example.com)"
# 32+ random bytes, e.g. `openssl rand -base64 32`. Changing it logs everyone out.
SESSION_SECRET=
PORT=8787

# Deployment (docker-compose.yml)
# Your zrok account token (from the zrok web console)
ZROK2_ENABLE_TOKEN=
# The public URL zrok prints for the share, filled in after the first `zrok2 share public`
PUBLIC_ORIGIN=

# Only for `npm run capture` (local fixture capture). Never commit.
IDU_LOGIN=
IDU_PASSWORD=
