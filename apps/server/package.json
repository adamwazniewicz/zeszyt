{
  "name": "@zeszyt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --clean",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "cheerio": "^1.0.0",
    "domhandler": "^5.0.3",
    "hono": "^4.6.0",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.13.0",
    "@zeszyt/shared": "*",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
